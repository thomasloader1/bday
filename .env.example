# Password del panel /admin (se compara contra la cookie admin-session)
ADMIN_PASSWORD=change-me

# Puertos en el host para docker compose (default 3000 / 3001)
# WEB_PORT=3000
# WEB_DEV_PORT=3001

# Signs the admin session cookie (any long random string, e.g. `openssl rand -hex 32`)
SESSION_SECRET=change-me-too
